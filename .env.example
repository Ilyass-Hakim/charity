# Database Configuration
# Use these variables to configure your database connection
DB_URL=jdbc:postgresql://localhost:5432/charity_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe API Keys (Test Mode)
# Get these from your Stripe Dashboard
STRIPE_TEST_SK=sk_test_your_secret_key
STRIPE_TEST_PK=pk_test_your_public_key

# SMTP Configuration (e.g., Gmail App Password)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_app_password
